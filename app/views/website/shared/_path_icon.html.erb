<%# locals: (icon:) -%>
<%# An item's icon: one of the theme's by name, or an outline path (24×24) as the Astro site took them. %>
<% if Oldmill::Engine.root.join("app/assets/images/oldmill/icons/#{icon.to_s.parameterize}.svg").exist? %>
  <%= oldmill_icon(icon.to_s.parameterize) %>
<% else %>
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="<%= icon %>" /></svg>
<% end %>
