<!DOCTYPE html>
<html lang="<%= content_for(:lang).presence || oldmill_locale %>" data-theme="<%= website_design(:color_scheme) %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% if website_design(:theme_toggle) %>
      <%# A visitor's own choice of dark or light, before the first paint, so it never flashes. %>
      <script nonce="<%= content_security_policy_nonce %>">
        try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t } catch (e) {}
      </script>
    <% end %>
    <%# The theme's files come from the theme itself (Oldmill::AssetsController), not the asset pipeline. %>
    <% %w[inter.woff2 fraunces.woff2 ibm-plex-mono-400.woff2].each do |font| %>
      <link rel="preload" href="<%= oldmill_asset_path(font) %>" as="font" type="font/woff2" crossorigin="anonymous">
    <% end %>
    <link rel="stylesheet" href="<%= oldmill_asset_path("site.css") %>">
    <%= website_design_tags %>
    <%= yield :head %>
    <link rel="icon" type="image/png" href="<%= oldmill_favicon_href %>">
    <link rel="apple-touch-icon" href="<%= oldmill_favicon_href %>">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="sitemap" href="/sitemap.xml">
    <%= website_scripts("head") %>
    <%= oldmill_javascript_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "website/shared/nav" %>
    <main id="main"><%= yield %></main>
    <%= render "website/shared/footer" %>
    <%= website_scripts("body") %>
  </body>
</html>
